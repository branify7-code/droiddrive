# Local fallback storage (SQLite) — used only when Google Drive is not connected.
# Must point to a PERSISTENT disk location; on ephemeral/serverless hosting the
# local mode loses data on every restart (Drive mode is unaffected).
DATABASE_URL=file:/absolute/path/to/db/custom.db

# Directory for uploaded file blobs (local mode). Default: ./db/vstorage
# LOCAL_STORAGE_DIR=/absolute/path/to/db/vstorage

# Max upload size for the local storage API, in megabytes. Default: 200
# LOCAL_UPLOAD_LIMIT_MB=200
